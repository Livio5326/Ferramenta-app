    valore_magazzino = sum(
        float(d.get("prezzo_acquisto", 0)) * int(d.get("quantita", 0)) for d in docs
    )
    valore_vendita = sum(
        float(d.get("prezzo_vendita", 0)) * int(d.get("quantita", 0)) for d in docs
