def _norm_match_text(value: str | None) -> str:
    import re
    value = str(value or "").strip().upper()
    value = re.sub(r"[^A-Z0-9]+", " ", value)
    value = re.sub(r"\s+", " ", value).strip()
    return value


async def reconcile_invoice_import(numero_fattura: str):
    """
    Ricalcola lo stato reale di una fattura:
    - un pending è importato se trova un prodotto nel catalogo
      per barcode, codice prodotto/codice, oppure descrizione normalizzata.
    - aggiorna pending_invoice_products
    - aggiorna invoice_imports con conteggi coerenti.
    """
    numero_fattura = str(numero_fattura or "").strip()
    if not numero_fattura:
        return {
            "numero_fattura": numero_fattura,
            "importati": 0,
            "non_trovati": 0,
        }

    pendenti = await db.pending_invoice_products.find({
        "numero_fattura": numero_fattura
    }).to_list(5000)

    importati = 0
    non_trovati = 0

    for p in pendenti:
        barcode = str(p.get("barcode") or "").strip()
        codice = str(
            p.get("codice_prodotto")
            or p.get("codice")
            or p.get("codice_fornitore")
            or ""
        ).strip()
        descrizione = str(p.get("descrizione") or "").strip()

        prodotto = None

        # 1. Match forte: barcode
        if barcode:
            prodotto = await db.products.find_one({"barcode": barcode})

        # 2. Match forte: codice prodotto / codice
        if not prodotto and codice:
            prodotto = await db.products.find_one({
                "$or": [
                    {"codice_prodotto": codice},
                    {"codice": codice},
                    {"codice_fornitore": codice},
                ]
            })

        # 3. Match descrizione esatta normalizzata
        if not prodotto and descrizione:
            descr_norm = _norm_match_text(descrizione)

            # Prima prova con campo descrizione normale
            candidates = await db.products.find({
                "descrizione": {"$exists": True, "$ne": ""}
            }).to_list(10000)

            for c in candidates:
                if _norm_match_text(c.get("descrizione")) == descr_norm:
                    prodotto = c
                    break

        if prodotto:
            importati += 1

            await db.pending_invoice_products.update_one(
                {"_id": p["_id"]},
                {
                    "$set": {
