                            else "codice" if codice
                            else "descrizione"
                        ),
                        "updated_at": datetime.now(timezone.utc).isoformat(),
                    }
                }
            )
        else:
            non_trovati += 1

            await db.pending_invoice_products.update_one(
                {"_id": p["_id"]},
                {
                    "$set": {
                        "stato": "da_salvare",
                        "status": "da_salvare",
                        "importato": False,
                        "risolto": False,
                        "da_importare": True,
                        "updated_at": datetime.now(timezone.utc).isoformat(),
                    },
                    "$unset": {
                        "matched_product_id": "",
                        "matched_by": "",
                    }
                }
            )

    await db.invoice_imports.update_many(
        {
            "$or": [
                {"numero_fattura": numero_fattura},
                {"fattura": numero_fattura},
                {"numero": numero_fattura},
            ]
        },
        {
            "$set": {
                "prodotti_aggiornati": importati,
                "aggiornati": importati,
                "updated_count": importati,

                "barcode_non_trovati": non_trovati,
                "non_trovati": non_trovati,
                "prodotti_non_trovati": non_trovati,
                "not_found": non_trovati,

                "registrata_manualmente": importati > 0,
                "updated_at": datetime.now(timezone.utc).isoformat(),
            }
        }
    )

    return {
        "numero_fattura": numero_fattura,
        "importati": importati,
        "non_trovati": non_trovati,
    }



