{
  "expo": {
    "name": "frontend",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Scansiona barcode e scatta foto prodotti",
        "NSPhotoLibraryUsageDescription": "Allega foto prodotti dalla galleria"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES"
      ],
      "package": "com.dario0228.frontend"
    },
    "androidStatusBar": {
      "backgroundColor": "#1F3A2A"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1F3A2A"
        }
      ],
      "expo-font",
      [
        "expo-navigation-bar",
        {
          "hidden": true,
          "style": "dark",
          "enforceContrast": false
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "backgroundColor": "#1F3A2A",
    "extra": {
      "router": {},
      "expo-navigation-bar": {
        "hidden": true,
        "style": "dark",
        "enforceContrast": false
      },
      "eas": {
        "projectId": "6806bb11-0fef-4fc2-8681-f0c82b9939bf"
      }
    }
  }
}
